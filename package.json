{
  "name": "blog",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync && pnpm gen",
    "check": "pnpm gen && svelte-kit sync && pnpm check:automation && svelte-check --tsconfig ./tsconfig.json",
    "check:automation": "tsc --project .github/scripts/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "pnpm run test:automation && pnpm run test:unit --run --coverage && pnpm run test:e2e",
    "test:automation": "node --test .github/scripts/delivery/delivery.test.ts",
    "test:e2e": "playwright test",
    "test:preview": "node tests/auth-preview.ts",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "gen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "playwright": "^1.65.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^3.1.0",
    "wrangler": "^4.158.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "7.23.0",
    "jose": "^6.2.15",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  }
}
