{
  "name": "blog",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x",
    "pnpm": "12.x"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "pnpm gen && vite dev",
    "build": "pnpm gen && vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --env preview --local --infer-origin-from-routes=false --port 4173",
    "prepare": "pnpm gen && svelte-kit sync",
    "check": "pnpm gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:automation": "tsc --project scripts/automation/tsconfig.json",
    "check:watch": "pnpm gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:automation": "node --test scripts/automation/*.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm test:automation && pnpm test:unit && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:install": "playwright install chromium",
    "gen": "wrangler types --env preview --include-main-module=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --env preview --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "jose": "6.2.17",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "uuid": "^14.0.3"
  }
}
