{
  "name": "blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm types:check && vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "pnpm types:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test:workflow": "node --test .github/scripts/*.test.ts",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm run test:workflow && pnpm run test:unit --run && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "types:check": "node .github/scripts/worker-types.ts check",
    "gen": "node .github/scripts/worker-types.ts generate && prettier --write worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply blog --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog --remote"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "miniflare": "5.20261006.0-alpha",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^2.2.1",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "jose": "^6.2.12",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  }
}
