{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "preview": {
      "name": "blog-preview",
      "routes": [
        { "pattern": "blog-preview.herokwon.dev", "custom_domain": true }
      ],
      "vars": { "APP_ENVIRONMENT": "preview" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blog-preview-db",
          "database_id": "fa30779e-fc14-46fe-b4d0-ec6594c5c12c",
          "migrations_dir": "./drizzle",
          "migrations_table": "d1_migrations",
          "remote": false
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "blog-preview-bucket",
          "remote": false
        }
      ]
    },
    "production": {
      "name": "blog",
      "routes": [{ "pattern": "blog.herokwon.dev", "custom_domain": true }],
      "vars": { "APP_ENVIRONMENT": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blog-db",
          "database_id": "35fea2bd-61f8-40d2-8786-5aa761b1724c",
          "migrations_dir": "./drizzle",
          "migrations_table": "d1_migrations",
          "remote": false
        }
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "blog-bucket", "remote": false }
      ]
    }
  }
}
