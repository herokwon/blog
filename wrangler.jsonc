{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "workers_dev": true,
  "preview_urls": true,
  "env": {
    "preview": {
      "name": "blog-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blog-preview-db",
          "migrations_dir": "./drizzle",
          "migrations_table": "d1_migrations",
          "remote": false
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "blog-preview-bucket",
          "remote": false
        }
      ]
    },
    "production": {
      "name": "blog",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blog-db",
          "migrations_dir": "./drizzle",
          "migrations_table": "d1_migrations",
          "remote": false
        }
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "blog-bucket", "remote": false }
      ]
    }
  }
}
